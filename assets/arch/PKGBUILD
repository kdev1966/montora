# Maintainer: kdev1966 <kdev1966@users.noreply.github.com>
pkgname=montora
pkgver=${MONTORA_VERSION:?MONTORA_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64')
url="https://github.com/kdev1966/montora"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${MONTORA_STAGE:?MONTORA_STAGE must point at the staged folder}
id=io.github.kdev1966.montora

package() {
  install -Dm755 "$stage/montora" "$pkgdir/opt/montora/montora"
  install -d "$pkgdir/opt/montora/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/montora/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/montora/montora "$@"\n' > "$pkgdir/usr/bin/montora"
  chmod 755 "$pkgdir/usr/bin/montora"
  install -Dm644 "$stage/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  sed -i 's|^Exec=montora|Exec=/opt/montora/montora %U|' "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "$stage/$id.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$id.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/montora/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/montora/THIRD_PARTY_NOTICES.md"
}
