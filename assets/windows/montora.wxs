<?xml version="1.0" encoding="UTF-8"?>
<!--
  Montora's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.7 -d Root=C:\...\montora
              -d Stage=C:\...\stage\Montora-0.2.7-windows-x86_64
              -o stage\Montora-0.2.7-windows-x86_64.msi assets\windows\montora.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="Montora"
           Manufacturer="Montora contributors"
           Version="$(var.Version)"
           UpgradeCode="A23E1996-D21D-4F9A-91AF-5D727D5D7711"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Montora is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="montora.ico" SourceFile="$(var.Root)\assets\icons\montora.ico" />
    <Property Id="ARPPRODUCTICON" Value="montora.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kdev1966/montora" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Montora" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Montora" />
    </StandardDirectory>

    <Feature Id="Main" Title="Montora" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="779809D3-F4FE-48FD-9F6F-5712D8AEA17C">
      <Shortcut Id="StartMenuShortcut"
                Name="Montora"
                Description="Video editor"
                Target="[INSTALLFOLDER]montora.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="montora.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Montora" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
